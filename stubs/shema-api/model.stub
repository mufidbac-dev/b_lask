use Illuminate\Database\Eloquent\SoftDeletes;

class {{ model }} extends Model
{
    use HasFactory, HasUuids, SoftDeletes;

    protected $table = '{{ tableName }}';

    protected $primaryKey = '{{ primaryKey }}';

    protected $fillable = [
        {{ fillableFields }}
    ];

    protected function casts(): array
    {
        return [
            'created_at' => 'datetime',
            'updated_at' => 'datetime',
            'deleted_at' => 'datetime',
        ];
    }

    // -------------------------------------------------------------------------
