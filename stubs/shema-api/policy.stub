<?php

namespace {{ namespace }};

use {{ modelNamespace }};
use App\Models\User;
use Illuminate\Auth\Access\HandlesAuthorization;

class {{ model }}Policy
{
    use HandlesAuthorization;

    public function viewAny(User $user): bool
    {
        return $user->can('view-any-{{ permissionPrefix }}');
    }

    public function view(User $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('view-{{ permissionPrefix }}');
    }

    public function create(User $user): bool
    {
        return $user->can('create-{{ permissionPrefix }}');
    }

    public function update(User $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('update-{{ permissionPrefix }}');
    }

    public function delete(User $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('delete-{{ permissionPrefix }}');
    }

    public function restore(User $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('restore-{{ permissionPrefix }}');
    }

    public function forceDelete(User $user, {{ model }} ${{ modelVariable }}): bool
    {
        return $user->can('force-delete-{{ permissionPrefix }}');
    }

    public function export(User $user): bool
    {
        return $user->can('export-{{ permissionPrefix }}');
    }
}
